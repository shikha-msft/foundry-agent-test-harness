# Copy to .env and fill in.
#
# There are no keys or secrets here. Every Azure call authenticates with
# DefaultAzureCredential - your `az login` identity locally, the App Service
# managed identity when deployed.

# --- Required ---
# Foundry project endpoint (Foundry account -> project).
AZURE_AI_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Deployment name of the chat model the agents run on. The UI can switch between
# any chat deployment on the account; this is the default selection.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5-mini

# --- Telemetry ---
# Leave empty in normal use. When empty, the App Insights resource linked to the
# Foundry project is discovered through the project's AppInsights connection, so
# app traces land beside Foundry's own. Set it only to force a different resource.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Log Analytics workspace GUID (the Workspace ID, not the ARM resource ID) behind
# that App Insights. Required only for the Telemetry tab.
LOG_ANALYTICS_WORKSPACE_ID=

# --- Optional overrides ---
OTEL_SERVICE_NAME=foundry-agent-test-harness
# Agent names come from agents/*.yaml; each spec's `name_env` can override one.
RANDOM_FACT_AGENT_NAME=randomfact-agent
NEWS_AGENT_NAME=news-agent

# --- Harness ---
# Folder of agent specs (*.yaml). Defaults to ./agents.
HARNESS_AGENTS_DIR=
# Comma-separated Python modules imported at startup, e.g. to register_backend().
HARNESS_PLUGINS=
